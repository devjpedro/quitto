{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  // Ultracite 7.x ships its Biome preset as versioned configs under the
  // `ultracite/biome/*` export paths (there is no top-level "ultracite"
  // config in 7.x, unlike older versions). core = base preset,
  // react = JSX/React rules (apps/web), vitest = test-file rules.
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/vitest"
  ],
  "files": {
    // We lint only first-party TS/TSX/CSS source and tests. Build/tool config
    // files (vite/drizzle config), the static HTML entry, package manifests,
    // and the drizzle-kit generated migrations/snapshots are intentionally
    // excluded. A leading-negation list means "everything except these" in
    // Biome 2.x; Biome canonicalizes it to this form (it strips a redundant
    // explicit "**"), so do not re-add one — it will be removed on --write.
    // SVGs are generated assets too: apps/web/scripts/app-icons.tsx writes
    // the favicon as the AppIcon's own markup, and a test keeps the two in
    // sync, so the formatter must not rewrap it.
    "includes": [
      "!**/*.config.ts",
      "!**/drizzle",
      "!**/*.json",
      "!**/*.jsonc",
      "!**/*.html",
      "!**/*.svg",
      "!**/src/paraglide"
    ]
  },
  "overrides": [
    {
      // TanStack Router file-based routes usam $ (params), . (nesting) e _ (pathless)
      // nos nomes de arquivo — conflita com kebab-case. A convenção do framework manda aqui.
      "includes": ["apps/web/src/routes/**"],
      "linter": {
        "rules": { "style": { "useFilenamingConvention": "off" } }
      }
    },
    {
      // biome 2.5.x endureceu noMisplacedAssertion e passou a acusar asserções
      // dentro de wrappers/callbacks de teste do API (falso-positivo — elas
      // estão em test() e rodam no `bun test`). Relaxa só nos testes do API.
      "includes": ["apps/api/tests/**"],
      "linter": {
        "rules": { "suspicious": { "noMisplacedAssertion": "off" } }
      }
    },
    {
      // CRC16-CCITT (checksum do BR Code / PIX estático) é definido em termos
      // de deslocamento e XOR de bits — não há forma idiomática de expressar
      // o algoritmo sem operadores bitwise. O teste reimplementa o mesmo
      // algoritmo de forma independente para validar o CRC, então também
      // precisa da exceção.
      "includes": [
        "packages/shared/src/pix.ts",
        "packages/shared/tests/pix.test.ts"
      ],
      "linter": {
        "rules": { "suspicious": { "noBitwiseOperators": "off" } }
      }
    },
    {
      // FNV-1a + o finalizador do murmur3 (a cor do avatar pelo nome, mockup 13)
      // são definidos em XOR, multiplicação de 32 bits e deslocamento: não há
      // forma idiomática sem operadores bitwise. Mesmo caso do CRC do PIX acima.
      // Só o arquivo do hash: o teste não usa operador de bits.
      "includes": ["apps/web/src/lib/avatar-color.ts"],
      "linter": {
        "rules": { "suspicious": { "noBitwiseOperators": "off" } }
      }
    }
  ]
}
